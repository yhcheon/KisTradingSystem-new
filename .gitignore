# ── vi/vim 백업 파일 ──
*~
*.un~
*.swp
*.swo

# ── 환경 변수 ──
.env
backend/.env
backend/.token

# ── 로그 ──
backend/logs/

# ── 빌드 산출물 ──
backend/target/
frontend/node_modules/
frontend/dist/

# ── OS/IDE ──
.DS_Store
Thumbs.db
.vscode/
.idea/






