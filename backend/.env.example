# ============================================================
# .env.example - 환경 변수 템플릿
# .env 로 복사한 뒤 실제 값을 채우세요. .env 는 커밋하지 마세요.
# ============================================================

# ---------- 한국투자증권 API ----------
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CD=01

# ---------- API 도메인 ----------
KIS_REST_DOMAIN=https://openapi.koreainvestment.com:9443
KIS_WS_DOMAIN=ws://ops.koreainvestment.com:21000

# ---------- KRX 야간선물 검증 ----------
# KIS 공식 예제 종목코드. 실제 사용 계정/마스터의 야간 최근월물 코드가 있으면 교체하세요.
KIS_NIGHT_FUTURES_CODE=101W9000

# ---------- 토큰 캐시 ----------
TOKEN_CACHE_FILE=./.token

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- 백엔드 서버 ----------
BACKEND_BIND_ADDR=127.0.0.1:8080

# ---------- 로그 ----------
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Supabase ----------
SUPABASE_URL=https://<프로젝트ID>.supabase.co
SUPABASE_ANON_KEY=<anon 키>
SUPABASE_SERVICE_ROLE_KEY=<service_role 키>
SUPABASE_JWT_SECRET=<JWT secret>
