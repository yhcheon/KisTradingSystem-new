# ============================================================
# .env.example - 환경 변수 템플릿
# 이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 채우세요.
# .env 는 절대 커밋하지 마세요 (.gitignore 처리됨)
#
# [토큰 안내]
# - 토큰 파일(.token)은 프로그램이 루트의 고정 경로(./.token)에 저장합니다.
# - .token 파일에는 "토큰값 + 발행시간"이 함께 기록되며,
#   프로그램이 발행시간 기준 24시간 경과 여부를 스스로 판단하여
#   자동 재발급합니다.
# - 따라서 .env 에 토큰 관련 항목을 두지 않습니다.
# - .token 은 절대 Git 에 올리지 않습니다 (.gitignore 처리됨).
# ============================================================

# ---------- 한국투자증권 API ----------
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PROD_CD=01

# ---------- API 도메인 ----------
KIS_REST_DOMAIN=https://openapi.koreainvestment.com:9443
KIS_WS_DOMAIN=ws://ops.koreainvestment.com:21000

# ---------- 토큰 캐시 ----------
TOKEN_CACHE_FILE=./.token

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379

# ---------- 백엔드 서버 ----------
# 로컬 개발: 127.0.0.1:8080 / Docker·외부 서버: 0.0.0.0:8080
BACKEND_BIND_ADDR=127.0.0.1:8080

# ---------- 로그 ----------
LOG_LEVEL=info
LOG_DIR=./logs

# ---------- CORS ----------
# 실제 프론트엔드 Origin만 쉼표로 구분해 입력 (예: https://example.com)
# 미설정 시 localhost:5173 및 127.0.0.1:5173만 허용
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# 신규 (Supabase)
SUPABASE_URL=https://<프로젝트ID>.supabase.co
SUPABASE_ANON_KEY=<anon 키>
SUPABASE_SERVICE_ROLE_KEY=<service_role 키>  # 백엔드 전용, 절대 노출 금지
SUPABASE_JWT_SECRET=<JWT secret>




